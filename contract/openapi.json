{
  "openapi": "3.1.0",
  "info": {
    "title": "DSKT API",
    "version": "0.1.0",
    "description": "DSKT backend contract. Health operations expose no connection details."
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/auth/local/sign-in": {
      "post": {
        "operationId": "localSignIn",
        "summary": "Sign in with local credentials",
        "tags": [
          "auth"
        ],
        "description": "Exchanges a username and password for an HttpOnly session cookie. Invalid credentials return a generic error without indicating whether the username exists.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "security": [],
        "responses": {
          "200": {
            "description": "Sign-in succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "email": {
                          "type": "string"
                        },
                        "displayName": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "displayName"
                      ],
                      "additionalProperties": false,
                      "description": "The currently authenticated application user."
                    }
                  },
                  "required": [
                    "user"
                  ],
                  "additionalProperties": false,
                  "description": "Sign-in succeeded."
                }
              }
            }
          },
          "401": {
            "description": "Credentials were not accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "invalid_credentials"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Credentials were not accepted."
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getSession",
        "summary": "Get current session",
        "tags": [
          "auth"
        ],
        "description": "Returns the authenticated user from the session cookie, or 401.",
        "security": [],
        "responses": {
          "200": {
            "description": "Sign-in succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "email": {
                          "type": "string"
                        },
                        "displayName": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "displayName"
                      ],
                      "additionalProperties": false,
                      "description": "The currently authenticated application user."
                    }
                  },
                  "required": [
                    "user"
                  ],
                  "additionalProperties": false,
                  "description": "Sign-in succeeded."
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated or session expired/revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "unauthorized"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false,
                  "description": "Not authenticated or session expired/revoked."
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-out": {
      "post": {
        "operationId": "signOut",
        "summary": "Sign out",
        "tags": [
          "auth"
        ],
        "description": "Revokes the session cookie.",
        "security": [],
        "responses": {
          "200": {
            "description": "Session revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false,
                  "description": "Session revoked."
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Process liveness",
        "tags": [
          "health"
        ],
        "description": "Reports whether this API process can serve. It does not check PostgreSQL.",
        "security": [],
        "responses": {
          "200": {
            "description": "The API process can serve requests.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "live"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "description": "The API process can serve requests."
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Database readiness",
        "tags": [
          "health"
        ],
        "description": "Checks that PostgreSQL accepts a query. The response contains no connection details.",
        "security": [],
        "responses": {
          "200": {
            "description": "Required dependencies accepted a readiness check.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "description": "Required dependencies accepted a readiness check."
                }
              }
            }
          },
          "503": {
            "description": "A required dependency did not accept a readiness check.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "not_ready"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false,
                  "description": "A required dependency did not accept a readiness check."
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local backend"
    }
  ]
}
